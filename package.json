{
  "name": "social-update",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "description": "Local social journal \u2014 collect daily activity, generate copy-ready LinkedIn drafts.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "test": "node --test web/src/*.test.mjs",
    "collect": "node dist/collect.js",
    "claude-web:script": "node dist/claude-web-script.js",
    "claude-web:append": "node dist/claude-web-append.js",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}

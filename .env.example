# Obsidian vault root — used by the vault-keeper scripts (daily/weekly notes),
# not by collection. Path has spaces on this box, so keep the quotes.
VAULT_PATH="/home/you/obsidian.md"

# Claude Code session logs root. The only collection source.
CLAUDE_PROJECTS=~/.claude/projects

# Local web server port.
PORT=4100

# SQLite database file (local runs only; the cluster mounts its own).
DB_PATH=./social.sqlite

# Remote ingest target. Set -> the collector POSTs to /api/ingest instead of
# opening a local SQLite file.
INGEST_URL=https://social.example.com

# Collection run: scratch dir for the manifest, per-session summaries, tags and
# the state file that makes runs incremental.
CLAUDE_WORK_DIR=~/.cache/social-update/claude
# Sessions older than this are never summarized — the only brake on fan-out width.
CLAUDE_LOOKBACK_DAYS=14
# Wall-clock ceiling on a collection run. Overrunning is graceful: sessions already
# summarized are imported, the rest stay pending for the next run.
CLAUDE_COLLECT_BUDGET_MIN=120

# Local summarizer. The collector drives the llama.cpp router from the ollama-k3s
# repo: /v1 is the OpenAI-compatible surface, and the model lifecycle endpoints sit
# at that host's root. A model the run loads is unloaded when it finishes; one found
# already resident is left alone.
LLM_BASE_URL=http://127.0.0.1:1921/v1
LLM_MODEL=qwen3.6-35b-a3b
# Attempts per session. Attempt 1 gets the transcript; a rejected attempt gets the
# validator's own errors back as a correction turn.
LLM_ATTEMPTS=3
